# ── App ───────────────────────────────────────────────────────────────────
# Master key legada: não administra mais nada (admin exige login com TOTP). Chaves de
# aplicação são criadas por um admin em /admin/clients ou, no servidor, com:
#   python -m scripts.manage_api_clients create <nome> --permission trem:file_editor
API_KEY=sua-chave-admin-aqui
API_URL=http://localhost:3002
# Opcional: onde os links dos e-mails abrem (cadastro, senha, login). Padrão: API_URL.
FRONTEND_URL=
# Origens dos fronts que chamam a API direto do navegador, separadas por vírgula.
# Vazio: sem CORS.
CORS_ORIGINS=
DEBUG=false

# ── Banco de dados ────────────────────────────────────────────────────────
POSTGRES_PASSWORD=senha-segura-aqui
# DATABASE_URL é montado automaticamente no docker-compose
# Para rodar local sem Docker:
# DATABASE_URL=postgresql+asyncpg://trem:senha-segura-aqui@localhost:5432/trem

# ── JWT RS256 — gere com: python scripts/generate_keys.py ─────────────────
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Opcional: `iss` dos tokens (padrão: API_URL) e chaves públicas aposentadas ainda
# aceitas durante uma troca de chave, separadas por |||
# JWT_ISSUER=https://api.didilv93.com
# JWT_EXTRA_PUBLIC_KEYS=

# ── Login ─────────────────────────────────────────────────────────────────
# LOGIN_MAX_FAILURES_PER_USERNAME=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_FAILURE_WINDOW_SECONDS=900
# Só em desenvolvimento local sem HTTPS:
# COOKIE_SECURE=false

# ── Segundo fator ─────────────────────────────────────────────────────────
# Chave AES-256 dos segredos TOTP (32 bytes, base64url). Sem ela não há MFA, e as rotas
# de admin, que exigem login com segundo fator, ficam inacessíveis. Gere com:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Trocar a chave invalida todos os TOTP cadastrados.
MFA_ENCRYPTION_KEY=

# ── Cadastro ──────────────────────────────────────────────────────────────
# Quem recebe o aviso de cadastro pendente, além dos usuários com trem:admin
# (padrão: EMAIL_RECIPIENT)
# ADMIN_EMAIL=
# SIGNUP_ENABLED=true
# EMAIL_TOKEN_TTL_HOURS=24
# SIGNUP_MAX_PER_IP=5
# USERNAME_CHECK_MAX_PER_IP=60

# ── Email (SMTP) ──────────────────────────────────────────────────────────
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=seu-email@gmail.com
EMAIL_SMTP_PASSWORD=sua-senha-de-app
EMAIL_RECIPIENT=destinatario-feedback@gmail.com

# ── API Aérea (opcional — mesmo nome de serviço Docker) ───────────────────
AIRLINE_API_URL=http://airline-api:3003
AIRLINE_API_KEY=

# ── LLM (opcional — container trem-llm na rede Docker trem-llm) ───────────
LLM_API_URL=http://trem-llm:8080
LLM_API_KEY=

# ── Scraper do LinkedIn (opcional — orquestrador linkedinho na rede Docker) ──
# SCRAPER_API_KEY é o INTERNAL_API_KEY do orquestrador
SCRAPER_API_URL=http://linkedinho:8080
SCRAPER_API_KEY=

# ── Arquivos ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=52428800
# Limite do corpo da requisição inteira (soma dos arquivos); /audio e /movie usam o de mídia
MAX_REQUEST_SIZE=52428800
MAX_MEDIA_REQUEST_SIZE=104857600
